<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <!--
      项目自定义的 Fluent 补充样式。
      基础色板、控件模板全部来自 WPF-UI 的 ThemesDictionary / ControlsDictionary，
      这里只放本项目特有的东西：图标字体、工具栏按钮、排版层级。
    -->

    <!-- Fluent 图标字体（Win11 优先，Win10 回退到 MDL2） -->
    <FontFamily x:Key="FluentIconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- 承载字体：Win11 用 Segoe UI Variable，Win10 回退 Segoe UI -->
    <FontFamily x:Key="FluentTextFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="FluentDisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="FluentMonoFont">Cascadia Mono, Consolas</FontFamily>

    <Style x:Key="FluentIcon" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FluentIconFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
    </Style>

    <!--
      工具栏按钮直接在 XAML 上写 Appearance/Width/Height 等属性，不额外定义 Style：
      给 ui:Button 指定显式 Style 会绕过 WPF-UI 的隐式样式（模板丢失 → 退回 WPF 默认浅灰按钮）。
    -->

    <!-- 排版层级：对齐 Fluent 2 type ramp -->
    <Style x:Key="FluentCaption" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FluentTextFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
    </Style>

    <Style x:Key="FluentBody" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FluentTextFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>

    <Style x:Key="FluentBodyStrong" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FluentTextFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>

    <!-- 设置分组标题：Fluent 用中性色 + 较大上间距 -->
    <Style x:Key="FluentSectionHeader" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FluentTextFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="Margin" Value="0,18,0,8" />
    </Style>

    <Style x:Key="FluentSettingLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FluentTextFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="FluentNote" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FluentTextFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,10,0,0" />
        <Setter Property="LineHeight" Value="17" />
    </Style>

    <!--
      Slider：覆盖 WPF-UI 的隐式样式。
      原模板会给滑块两端预留半个滑块宽度的空间，导致轨道够不到单元格两端，看起来"两头有缝"。
      这里改成「底层轨道铺满整行 + 滑块在轨道内滑动」：轨道两端完全贴边，滑块也不出格。
    -->
    <Style TargetType="Slider">
        <Setter Property="Height" Value="28" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Background="Transparent" Height="28">
                        <!-- 底轨：横跨整个宽度，两端不留空隙 -->
                        <Border Height="4" CornerRadius="2" VerticalAlignment="Center"
                                Background="{DynamicResource ControlStrongStrokeColorDefaultBrush}" />

                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Focusable="False" IsTabStop="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="4" CornerRadius="2" VerticalAlignment="Center"
                                                    Background="{DynamicResource AccentFillColorDefaultBrush}" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>

                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Focusable="False" IsTabStop="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>

                            <Track.Thumb>
                                <Thumb Width="16" Height="16" Focusable="False" IsTabStop="False">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <!-- 实心圆点 + Fluent 描边（之前只留填充、丢了边框） -->
                                            <Ellipse Fill="{DynamicResource AccentFillColorDefaultBrush}"
                                                     Stroke="{DynamicResource ControlStrongStrokeColorDefaultBrush}"
                                                     StrokeThickness="1" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
