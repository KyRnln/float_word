<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>FloatWord</AssemblyName>
    <RootNamespace>FloatWordWpf</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- 应用图标：exe 的文件图标 / 任务栏图标 -->
    <ApplicationIcon>Assets\floatword.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- 同一个 ico 作为资源打包，供窗口的 Window.Icon 使用 -->
    <Resource Include="Assets\floatword.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- 词库 -->
    <Content Include="dicts\**\*.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- 离线 TTS：Piper 引擎与语音模型（随程序一起输出） -->
    <Content Include="piper\bin\**\*" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="piper\voices\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

</Project>
