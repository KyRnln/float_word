<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>FloatWord</AssemblyName>
    <RootNamespace>FloatWordWpf</RootNamespace>
    <!-- 版本号：同时决定程序集版本、文件版本，以及「右键 exe → 属性 → 详细信息」里显示的版本 -->
    <Version>1.0.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- 应用图标：exe 的文件图标 / 任务栏图标 -->
    <ApplicationIcon>Assets\floatword.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- 同一个 ico 作为资源打包，供窗口的 Window.Icon 使用 -->
    <Resource Include="Assets\floatword.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- 词库与离线语音都属于「内容文件」：单文件发布不会把它们塞进 exe，
         必须同时声明 CopyToPublishDirectory，否则 PublishSingleFile 下 publish 目录会漏拷。 -->
    <Content Include="dicts\**\*.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="piper\bin\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="piper\voices\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <!--
    兜底拷贝：PublishSingleFile 下 SDK 有时不会把 Content 完整拷进 publish 目录
    （实测每个 glob 只剩 1 个文件）。这里在 Publish 之后显式再拷一遍，
    保证 dicts\ 与 piper\ 完整随包分发。
  -->
  <Target Name="CopyContentToPublishDir" AfterTargets="Publish">
    <ItemGroup>
      <_DictsToPublish Include="$(MSBuildProjectDirectory)\dicts\**\*" />
      <_PiperToPublish Include="$(MSBuildProjectDirectory)\piper\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_DictsToPublish)"
          DestinationFiles="@(_DictsToPublish->'$(PublishDir)dicts\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_PiperToPublish)"
          DestinationFiles="@(_PiperToPublish->'$(PublishDir)piper\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
